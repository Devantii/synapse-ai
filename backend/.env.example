# Copy to backend/.env and fill in. Never commit the real .env.

# Port the server listens on.
PORT=3000

# REQUIRED in production: long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset in development, a random secret is used and logins reset when the server restarts.
JWT_SECRET=
JWT_TTL=7d

# Set to "production" when hosting. The server refuses to start without JWT_SECRET in production.
NODE_ENV=development

# Database. Leave DATABASE_URL empty to use a local SQLite file (backend/data.db, or DB_PATH).
# Set it to a PostgreSQL connection string when hosting, e.g. Neon:
#   postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# DB_PATH=./data.db

# Optional: live AI coach replies. Without a key the coach gives rule-based replies, clearly labelled.
# Any OpenAI-compatible Chat Completions endpoint works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: LiveKit media server for voice rooms (scales past ~6 people, works on more networks).
# Leave empty to use peer-to-peer voice. See infra/livekit/README.md. Use LiveKit server 1.9+.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional WebRTC relay for peer-to-peer voice rooms on strict networks (corporate Wi-Fi, some mobile carriers).
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Behind a reverse proxy (Render, Nginx, etc.) set to 1 so rate limits see real client IPs.
# TRUST_PROXY=1

# Only needed if the dashboard is served from a different origin than the API.
# CORS_ORIGIN=https://your-dashboard.example.com
